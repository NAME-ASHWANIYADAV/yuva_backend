# Copy to .env and adjust. All values are optional; defaults are repo-relative.
# Path to the site configuration (default: configs/lamjana.yaml)
SUNFLOW_CONFIG=configs/lamjana.yaml
# Where raw/processed data, models and results are stored (default: repo root)
SUNFLOW_DATA_DIR=data
SUNFLOW_MODELS_DIR=models
SUNFLOW_RESULTS_DIR=results
# Logging level: DEBUG | INFO | WARNING
SUNFLOW_LOG_LEVEL=INFO
# Backend bind
SUNFLOW_HOST=127.0.0.1
SUNFLOW_PORT=8000
# Frontend dev server proxy target
VITE_API_BASE=http://127.0.0.1:8000
