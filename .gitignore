__pycache__/
*.pyc
.pytest_cache/
.env
*.egg-info/
build/
dist/
frontend/node_modules/
frontend/dist/
# cached public weather/forecast data, the trained forecast model and the measured results are committed on purpose:
# a fresh clone demos offline without re-downloading (Open-Meteo CC BY 4.0, NASA POWER public domain; see DATA_SOURCES.md)
data/raw/*.parquet
data/processed/*.parquet
results/**/runs.csv
results/safety/sweep_part*.json
results/safety/shard*.log
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
